<Project Sdk="Microsoft.NET.Sdk">
	<Import Project="$(MSBuildProjectDirectory)\..\..\Local.Build.props.user"
			Condition="Exists('$(MSBuildProjectDirectory)\..\..\Local.Build.props.user')" />
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<OutputType>Library</OutputType>
		<GenerateAssemblyInfo>false</GenerateAssemblyInfo>
		<NuGetAudit>false</NuGetAudit>
	</PropertyGroup>

	<PropertyGroup>
		<!-- Repository defaults. Local values imported above override these values. -->
		<VINTAGE_STORY Condition="'$(VINTAGE_STORY)' == ''">$(VINTAGE_STORY_HOME)</VINTAGE_STORY>
		<LOCAL_DEPENDENCIES Condition="'$(LOCAL_DEPENDENCIES)' == ''">$(MSBuildProjectDirectory)\..\..\..\vshelper\dependencies</LOCAL_DEPENDENCIES>
		<LOCAL_DEPLOY_SCRIPT Condition="'$(LOCAL_DEPLOY_SCRIPT)' == ''"></LOCAL_DEPLOY_SCRIPT>
	</PropertyGroup>

	<!--
    Local, machine-specific values are loaded from Local.Build.props.user
    at the repository root. That file must not be committed to Git.
  -->
	<PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Debug|AnyCPU'">
		<OutputPath>.\bin</OutputPath>
		<IntermediateOutputPath>.\obj\Debug\xskills\</IntermediateOutputPath>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Release|AnyCPU'">
		<OutputPath>.\bin</OutputPath>
		<IntermediateOutputPath>.\obj\Release\xskills\</IntermediateOutputPath>
	</PropertyGroup>

	<PropertyGroup>
		<BaseOutputPath>.\bin</BaseOutputPath>
	</PropertyGroup>

	<ItemGroup>
		<Compile Remove="bin\**" />
		<Compile Remove="src\Debug\**" />
		<Compile Remove="src\Patches\Mining\**" />
		<EmbeddedResource Remove="bin\**" />
		<EmbeddedResource Remove="src\Debug\**" />
		<EmbeddedResource Remove="src\Patches\Mining\**" />
		<None Remove="bin\**" />
		<None Remove="src\Debug\**" />
		<None Remove="src\Patches\Mining\**" />
	</ItemGroup>

	<ItemGroup>
		<Reference Include="0Harmony, Version=2.0.4.0, Culture=neutral, processorArchitecture=MSIL">
			<SpecificVersion>False</SpecificVersion>
			<HintPath>$(VINTAGE_STORY)\Lib\0Harmony.dll</HintPath>
		</Reference>
		<Reference Include="ACulinaryArtillery">
			<HintPath>$(LOCAL_DEPENDENCIES)\ACulinaryArtillery.dll</HintPath>
		</Reference>
		<Reference Include="ElectricalProgressive-QOL">
			<HintPath>$(LOCAL_DEPENDENCIES)\ElectricalProgressive-QOL.dll</HintPath>
		</Reference>
		<Reference Include="cairo-sharp">
			<HintPath>$(VINTAGE_STORY)\Lib\cairo-sharp.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="Overhaullib">
			<HintPath>$(LOCAL_DEPENDENCIES)\Overhaullib.dll</HintPath>
		</Reference>
		<Reference Include="primitivesurvival">
			<HintPath>$(LOCAL_DEPENDENCIES)\primitivesurvival.dll</HintPath>
		</Reference>
		<Reference Include="protobuf-net, Version=2.1.0.0, Culture=neutral, PublicKeyToken=257b51d87d2e4d67, processorArchitecture=MSIL">
			<SpecificVersion>False</SpecificVersion>
			<HintPath>$(VINTAGE_STORY)\Lib\protobuf-net.dll</HintPath>
		</Reference>
		<Reference Include="VintagestoryAPI">
			<HintPath>$(VINTAGE_STORY)\VintagestoryAPI.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="VintagestoryLib, Version=1.0.0.0, Culture=neutral, processorArchitecture=MSIL">
			<SpecificVersion>False</SpecificVersion>
			<HintPath>$(VINTAGE_STORY)\VintagestoryLib.dll</HintPath>
		</Reference>
		<Reference Include="VSSurvivalMod">
			<HintPath>$(VINTAGE_STORY)\Mods\VSSurvivalMod.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="VSEssentials">
			<HintPath>$(VINTAGE_STORY)\Mods\VSEssentials.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="VSCreativeMod">
			<HintPath>$(VINTAGE_STORY)\Mods\VSCreativeMod.dll</HintPath>
			<Private>False</Private>
		</Reference>
	</ItemGroup>

	<ItemGroup>
		<Content Include="assets\xskills\lang\cn.json" />
		<Content Include="assets\xskills\lang\de.json" />
		<Content Include="assets\xskills\lang\en.json" />
		<Content Include="assets\xskills\lang\es-es.json" />
		<Content Include="assets\xskills\lang\fr.json" />
		<Content Include="assets\xskills\lang\pl.json" />
		<Content Include="assets\xskills\lang\pt-br.json" />
		<Content Include="assets\xskills\lang\ro.json" />
		<Content Include="assets\xskills\lang\ru.json" />
		<Content Include="assets\xskills\lang\sv.json" />
		<Content Include="assets\xskills\lang\uk.json" />
		<Content Include="assets\xskills\patches\combat\combat.json" />
		<Content Include="assets\xskills\patches\digging.json" />
		<Content Include="assets\xskills\patches\farming\crops.json" />
		<Content Include="assets\xskills\patches\forestry\forestry.json" />
		<Content Include="assets\xskills\patches\husbandry\primitivesurvival.json" />
		<Content Include="assets\xskills\patches\husbandry\moreanimals.json" />
		<Content Include="assets\xskills\patches\metalworking.json" />
		<Content Include="assets\xskills\patches\mining.json" />
		<Content Include="assets\xskills\patches\xskills.json" />
		<Content Include="assets\xskills\recipes\barrel\mead.json" />
		<Content Include="assets\xskills\recipes\cooking\salt.json" />
		<Content Include="assets\xskills\recipes\cooking\lime.json" />
		<Content Include="assets\xskills\skills\combat.json" />
		<Content Include="assets\xskills\skills\digging.json" />
		<Content Include="assets\xskills\skills\farming.json" />
		<Content Include="assets\xskills\skills\forestry.json" />
		<Content Include="assets\xskills\skills\mining.json" />
		<Content Include="assets\xskills\skills\survival.json" />
		<Content Include="assets\xskills\skills\temporaladaptation.json" />
		<Content Include="modinfo.json" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\xlib\xlib.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Content Include="assets\xskills\patches\husbandry\animals.json" />
		<Content Include="assets\xskills\blocktypes\cage.json" />
		<Content Include="assets\xskills\effects\saturated.json" />
		<Content Include="assets\xskills\recipes\grid\cage.json" />
		<Content Include="assets\xskills\effects\effects.json" />
		<Content Include="assets\xskills\lang\ja.json" />
		<Content Include="assets\xskills\patches\cooking.json" />
		<Content Include="assets\xskills\lang\es-419.json" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="System.Data.DataSetExtensions" Version="4.5.0" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
	</ItemGroup>

	<ItemGroup>
		<Folder Include="assets\xskills\shapes\item\" />
	</ItemGroup>

	<Target Name="ValidateLocalBuildSettings" BeforeTargets="ResolveReferences">
		<Message Importance="High" Text="VINTAGE_STORY=$(VINTAGE_STORY)" />
		<Message Importance="High" Text="LOCAL_DEPENDENCIES=$(LOCAL_DEPENDENCIES)" />
		<Error Condition="'$(VINTAGE_STORY)' == ''"
			   Text="VINTAGE_STORY is not configured. Create Local.Build.props.user in the repository root and set VINTAGE_STORY." />
		<Error Condition="'$(VINTAGE_STORY)' != '' and !Exists('$(VINTAGE_STORY)\VintagestoryAPI.dll')"
			   Text="Invalid VINTAGE_STORY directory: $(VINTAGE_STORY). VintagestoryAPI.dll was not found." />
		<Error Condition="!Exists('$(LOCAL_DEPENDENCIES)\ACulinaryArtillery.dll')"
			   Text="Missing dependency: $(LOCAL_DEPENDENCIES)\ACulinaryArtillery.dll" />
		<Error Condition="!Exists('$(LOCAL_DEPENDENCIES)\ElectricalProgressive-QOL.dll')"
			   Text="Missing dependency: $(LOCAL_DEPENDENCIES)\ElectricalProgressive-QOL.dll" />
		<Error Condition="!Exists('$(LOCAL_DEPENDENCIES)\Overhaullib.dll')"
			   Text="Missing dependency: $(LOCAL_DEPENDENCIES)\Overhaullib.dll" />
		<Error Condition="!Exists('$(LOCAL_DEPENDENCIES)\primitivesurvival.dll')"
			   Text="Missing dependency: $(LOCAL_DEPENDENCIES)\primitivesurvival.dll" />
	</Target>

	<Target Name="PostRebuild" AfterTargets="Rebuild">
		<PropertyGroup>
			<ModName>$([System.Text.RegularExpressions.Regex]::Match('$([System.IO.File]::ReadAllText("$(ProjectDir)modinfo.json"))', '&quot;name&quot;\s*:\s*&quot;([^&quot;]+)&quot;').Groups[1].Value)</ModName>
			<ModVersion>$([System.Text.RegularExpressions.Regex]::Match('$([System.IO.File]::ReadAllText("$(ProjectDir)modinfo.json"))', '&quot;version&quot;\s*:\s*&quot;([^&quot;]+)&quot;').Groups[1].Value)</ModVersion>
			<ZipTempDir>$(TargetDir)ZipTemp</ZipTempDir>
			<ZipOutDir>$(MSBuildProjectDirectory)\..\..\..\releases\$(ModName)</ZipOutDir>
			<DevOutDir>$(ZipOutDir)\dev $(ModName)</DevOutDir>
		</PropertyGroup>

		<MakeDir Directories="$(ZipOutDir)" Condition="!Exists('$(ZipOutDir)')" />

		<RemoveDir Directories="$(ZipTempDir)" Condition="Exists('$(ZipTempDir)')" />
		<MakeDir Directories="$(ZipTempDir)" />

		<RemoveDir Directories="$(DevOutDir)" Condition="Exists('$(DevOutDir)')" />
		<MakeDir Directories="$(DevOutDir)" />

		<ItemGroup>
			<TargetFiles Include="$(TargetPath)" />
			<TargetFiles Include="$(TargetDir)$(TargetName).pdb" Condition="Exists('$(TargetDir)$(TargetName).pdb')" />
			<TargetFiles Include="$(TargetDir)$(TargetName).xml" Condition="Exists('$(TargetDir)$(TargetName).xml')" />
		</ItemGroup>

		<Copy SourceFiles="@(TargetFiles)" DestinationFolder="$(ZipTempDir)" />
		<Copy SourceFiles="@(TargetFiles)" DestinationFolder="$(DevOutDir)" />

		<ItemGroup>
			<ProjectFiles Include="$(ProjectDir)modinfo.json" />
			<ProjectFiles Include="$(ProjectDir)modicon.png" Condition="Exists('$(ProjectDir)modicon.png')" />
		</ItemGroup>

		<Copy SourceFiles="@(ProjectFiles)" DestinationFolder="$(ZipTempDir)" />
		<Copy SourceFiles="@(ProjectFiles)" DestinationFolder="$(DevOutDir)" />

		<ItemGroup>
			<AssetFiles Include="$(ProjectDir)assets\**\*" />
		</ItemGroup>

		<Copy SourceFiles="@(AssetFiles)" DestinationFolder="$(ZipTempDir)\assets\%(RecursiveDir)" />
		<Copy SourceFiles="@(AssetFiles)" DestinationFolder="$(DevOutDir)\assets\%(RecursiveDir)" />

		<ZipDirectory SourceDirectory="$(ZipTempDir)"
					  DestinationFile="$(ZipOutDir)\$(ModName) v$(ModVersion).zip"
					  Overwrite="true" />

		<RemoveDir Directories="$(ZipTempDir)" />

		<Exec Command="py &quot;$(LOCAL_DEPLOY_SCRIPT)&quot;"
			  Condition="'$(LOCAL_DEPLOY_SCRIPT)' != '' and Exists('$(LOCAL_DEPLOY_SCRIPT)')" />

		<Warning Text="LOCAL_DEPLOY_SCRIPT does not exist: $(LOCAL_DEPLOY_SCRIPT)"
				 Condition="'$(LOCAL_DEPLOY_SCRIPT)' != '' and !Exists('$(LOCAL_DEPLOY_SCRIPT)')" />
	</Target>

	<ProjectExtensions>
		<VisualStudio>
			<UserProperties assets_4xskills_4lang_4en_1json__JsonSchema="" />
		</VisualStudio>
	</ProjectExtensions>
</Project>
